{
    "name": "smart-clip-frontend",
    "version": "1.0.0",
    "description": "Smart Clipboard Manager - Desktop App",
    "main": "src/main.js",
    "scripts": {
        "start": "electron .",
        "dev": "electron . --dev",
        "build": "electron-builder",
        "dist": "electron-builder --publish=never"
    },
    "keywords": [
        "clipboard",
        "electron",
        "desktop",
        "productivity"
    ],
    "author": "Your Name",
    "license": "MIT",
    "devDependencies": {
        "electron": "^27.0.0",
        "electron-builder": "^24.6.4"
    },
    "dependencies": {
        "axios": "^1.6.0",
        "electron-store": "^8.1.0"
    },
    "build": {
        "appId": "com.smartclip.app",
        "productName": "Smart Clip",
        "directories": {
            "output": "dist"
        },
        "files": [
            "src/**/*",
            "public/**/*",
            "node_modules/**/*"
        ]
    }
}